# Directory where OAuth token files are stored
GOOGLE_CONFIG_DIR=~/.config/productivity-agent

# Local filename for the OAuth client credentials (downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Google Drive folder ID for NotebookLM uploads
NOTEBOOKLM_DRIVE_FOLDER_ID=

# Colon-separated list of local directories to scan for tagged markdown files
NOTEBOOKLM_SOURCE_DIRS=~/notes

# Local directory where podcast transcript markdown files are saved
PODCAST_OUTPUT_DIR=~/path/to/transcripts/podcast

# Number of most-recent episodes to fetch per playlist (default: 3)
PODCAST_FETCH_COUNT=3

# YouTube Data API v3 key (required for tool_podcast.py)
YOUTUBE_API_KEY=

# Path to Netscape-format cookies.txt exported from your browser (optional, reduces IP blocking)
YOUTUBE_COOKIES_FILE=~/path/to/youtube-cookies.txt
